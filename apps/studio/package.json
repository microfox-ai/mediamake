{
  "name": "studio",
  "version": "0.0.1",
  "private": true,
  "description": "MediaMake's studio: every local video (lyric, waveform, remix, shorts, AMV, kinetic type), thumbnails, posters, logos and brand renders in Remotion, the media library CLI and the audio analysis. Run its scripts with mm (bin/mm.mjs).",
  "bin": {
    "mm": "bin/mm.mjs"
  },
  "scripts": {
    "postinstall": "node scripts/generated.mjs --soft --quiet",
    "prepreview": "node scripts/generated.mjs --soft",
    "preview": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/studio.ts",
    "analyze": "uv run --project analysis python analysis/pipeline.py",
    "prepare-project": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/prepare.ts",
    "derive-media": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/derive-media.ts",
    "stills": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/stills.ts",
    "render-project": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/render.ts",
    "benchmark": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/render-tuning.ts",
    "render-queue": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/render-queue.ts",
    "bundle": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/project-bundle.ts",
    "lambda": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/lambda.ts",
    "map": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/map.ts",
    "cleanup-out": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/cleanup-out.ts",
    "media": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/media.ts",
    "test:library": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test scripts/library/*.test.ts",
    "pretype-check": "node scripts/generated.mjs --soft",
    "type-check": "tsc --noEmit",
    "logos": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/logos.ts",
    "logos-studio": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/brand-public.ts && remotion studio logoGraphics/index.ts --public-dir=out/brands/.public",
    "brand": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/brand.ts",
    "thumbs": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/thumbs.ts",
    "thumbs-studio": "remotion studio thumbnails/index.ts --public-dir=thumbnails/jobs",
    "remix": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/remix.ts",
    "shorts": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/shorts.ts",
    "lyric-shorts": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/lyric-shorts.ts",
    "amv": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/amv.ts",
    "amv-lab": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/amv-lab.ts",
    "image-index": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/image-index.ts",
    "sync-presets": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/sync-presets.ts",
    "fetch-inputs": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/fetch-inputs.ts",
    "wave-lab": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/wave-lab.ts",
    "preflight": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/preflight.ts",
    "golden": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/golden.ts",
    "migrate": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/migrate.ts",
    "notes": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/notes.ts",
    "wait-revision": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/wait-revision.ts",
    "loop-stats": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/loop-stats.ts",
    "look-grid": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/look-grid.ts",
    "transcribe": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/transcribe.ts",
    "kinetictype": "uv run --project analysis python scripts/kinetictype/cli.py",
    "yt-grab": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/youtube-grab.ts",
    "test:migrate": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test scripts/migrate.test.ts",
    "test:notes": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test scripts/notes.test.ts",
    "test:generated": "node --test scripts/generated.test.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@microfox/remotion": "*",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@remotion/bundler": "4.0.496",
    "@remotion/cli": "4.0.496",
    "@remotion/google-fonts": "4.0.496",
    "@remotion/lambda": "4.0.496",
    "@remotion/media": "4.0.496",
    "@remotion/media-utils": "4.0.496",
    "@remotion/renderer": "4.0.496",
    "@remotion/tailwind-v4": "^4.0.496",
    "@remotion/three": "4.0.496",
    "@types/opentype.js": "^1.3.8",
    "opentype.js": "^1.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.496",
    "tailwindcss": "^4.3.3",
    "three": "^0.176.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "typescript": "^5"
  }
}
