{
  "name": "@microfox/mediamake-mcp",
  "version": "0.1.2",
  "private": true,
  "description": "MCP server for Mediamake: projects, timelines, presets, media, transcription, workers, agents and renders.",
  "type": "module",
  "bin": {
    "mediamake-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "build:mcpb": "tsup --config tsup.mcpb.config.ts && mcpb validate mcpb/manifest.json && mcpb pack mcpb mediamake.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^20",
    "tsup": "^8",
    "typescript": "5.6.3",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
